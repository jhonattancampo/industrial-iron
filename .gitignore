# ============================================================
# Industrial Iron — .gitignore
# ============================================================

# Build artifacts
build/
out/
dist/

# Compiled plugin binaries (deployed locally, not versioned)
*.vst3
*.component
*.clap
*.dylib
*.so
*.dll
*.exe

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
_deps/

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
DerivedData/
*.moved-aside
*.hmap

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# VS Code
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.log
# Keep: .vscode/extensions.json (shared team extensions)

# CLion / JetBrains
.idea/
*.iml
cmake-build-*/

# Audio / DAW files (test sessions, not source)
*.als
*.logic
*.ptx
*.rpp

# IR files (if added later — too large for git, use LFS or exclude)
resources/ir/*.wav
resources/ir/*.aif

# Logs
*.log
npm-debug.log*

# Temp
*.tmp
*.bak
*.swp
*~

# gentle-ai / opencode cache
.atl/.skill-registry.cache.json

# OS generated
Thumbs.db
ehthumbs.db
Desktop.ini
